# Copy this file to .env for local Docker Compose use. Never commit .env.
POSTGRES_PASSWORD=replace-with-a-long-random-database-password
JWT_SECRET=replace-with-at-least-32-random-characters
DEMO_PASSWORD=replace-with-a-demo-password-at-least-12-characters
HQ_PORT=8080
# Optional comma-separated origins when calling the API outside the HQ proxy.
CORS_ORIGINS=
AISSTREAM_API_KEY=
